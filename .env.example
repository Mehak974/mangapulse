# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database Connection (Backend only - never exposed to browser)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
# Supabase Service Role Key (Backend only - required for verified webhook subscription sync)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment Webhook Verification (Backend only)
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token_here

# Google OAuth Credentials (Backend only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Amazon Affiliate Tag (for monetizing official volume purchases)
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=mangapulse-20

# Automation & Webhooks (Release Bot & Vercel Cron)
# Set your Discord channel webhook URL to receive instant alerts when chapters drop
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# Secret token to protect the release bot cron route (passed via Authorization header or ?key=)
CRON_SECRET=your_random_secure_cron_secret_here
# Canonical site base URL
NEXT_PUBLIC_SITE_URL=https://mangapulse.vercel.app
